# Required (dev + prod)
DATABASE_URL=postgres://user:password@localhost:5432/mbu_portal
JWT_SECRET=replace-with-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
# Used only by `npm run seed` to create the admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
# S3-compatible object storage (not wired yet; see README)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
